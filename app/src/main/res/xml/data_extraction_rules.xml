<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 ou mais novo. Backup na nuvem: só os prontuários (limite de 25 MB).
     Transferência direta para um aparelho novo: prontuários e fotos. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="pacientes.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="pacientes.json" />
        <include domain="file" path="fotos/" />
    </device-transfer>
</data-extraction-rules>
